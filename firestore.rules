rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myRol() {
      return get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data.rol;
    }

    match /perfiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
    }

    match /pacientes/{id} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || myRol() == 'doctora');
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.user_id == request.auth.uid || myRol() == 'doctora');
    }

    match /registros/{id} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || myRol() == 'doctora');
      allow create, update: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
    }

    match /consultas/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
  }
}